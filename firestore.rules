rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidDepartment(dept) {
      return dept in ['Biotechnology', 'Biomedical Engineering'];
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        getAdminData().isActive != false &&
        getAdminData().accountStatus != 'deactivated' &&
        getAdminData().role in ['ADMIN', 'FACULTY', 'admin', 'faculty'];
    }

    function isPlatformAdmin() {
      return isStaff() && getAdminData().isPlatformAdmin == true;
    }

    function getAdminDept() {
      return getAdminData().department;
    }

    function canAccessDepartment(dept) {
      return isPlatformAdmin() || (isStaff() && dept == getAdminDept());
    }

    function canAccessScopedDepartment(dept, year) {
      return isPlatformAdmin() || (
        isStaff() &&
        dept == getAdminDept() &&
        (!('authorizedYears' in getAdminData()) || getAdminData().authorizedYears.size() == 0 || year in getAdminData().authorizedYears)
      );
    }

    function canReadStudent(data) {
      return isPlatformAdmin() || (
        isStaff() &&
        data.department == getAdminDept() &&
        (!('authorizedYears' in getAdminData()) || getAdminData().authorizedYears.size() == 0 || data.year in getAdminData().authorizedYears)
      );
    }

    function validSpecialization(dept, specialization) {
      return (dept == 'Biotechnology' && specialization in [
        'Molecular Biology', 'Genetic Engineering', 'Bioinformatics', 'Microbiology',
        'Bioprocess Technology', 'Cell and Tissue Culture', 'Environmental Biotechnology', 'Other'
      ]) || (dept == 'Biomedical Engineering' && specialization in [
        'Medical Imaging', 'Biomedical Instrumentation', 'Biosensors', 'Rehabilitation Engineering',
        'Biomaterials', 'Medical Signal Processing', 'AI in Healthcare', 'Biomechanics', 'Other'
      ]);
    }

    function validCustomSpecialization(data) {
      return data.researchSpecialization != 'Other' || (
        data.customSpecialization is string &&
        data.customSpecialization.size() >= 3 &&
        data.customSpecialization.size() <= 100 &&
        data.customSpecialization.matches('^[A-Za-z0-9][A-Za-z0-9 _.,()/&-]{2,99}$')
      );
    }

    function validResearchSpecialization(data) {
      return !('researchSpecialization' in data) || (
        data.researchSpecialization is string &&
        validSpecialization(data.department, data.researchSpecialization) &&
        validCustomSpecialization(data)
      );
    }

    // Student Auth accounts and identifier reservations are created only by the trusted server.
    match /students/{studentId} {
      allow get: if isOwner(studentId) || canReadStudent(resource.data);
      allow list: if canReadStudent(resource.data);
      allow create: if false;
      allow update: if (
        canReadStudent(resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.registerNumber == resource.data.registerNumber &&
        request.resource.data.registrationNumberNormalized == resource.data.registrationNumberNormalized &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.year == resource.data.year &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'accountStatus', 'isActive', 'bio', 'skills', 'avatarUrl', 'updatedAt'])
      ) || (
        isOwner(studentId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.registerNumber == resource.data.registerNumber &&
        request.resource.data.registrationNumberNormalized == resource.data.registrationNumberNormalized &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.year == resource.data.year &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        request.resource.data.isActive == resource.data.isActive &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'bio', 'skills', 'avatarUrl', 'updatedAt'])
      );
      allow delete: if canReadStudent(resource.data);
    }

    // Faculty register as FACULTY. Platform administrators manage staff scope; client writes cannot grant platform scope.
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isPlatformAdmin() || (isStaff() && resource.data.department == getAdminDept());
      allow list: if isPlatformAdmin() || (isStaff() && resource.data.department == getAdminDept());
      allow create: if (
        isOwner(adminId) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'FACULTY' &&
        (!('isPlatformAdmin' in request.resource.data) || request.resource.data.isPlatformAdmin != true) &&
        validResearchSpecialization(request.resource.data) &&
        isValidDepartment(request.resource.data.department) &&
        !exists(/databases/$(database)/documents/students/$(request.auth.uid))
      );
      allow update: if (
        // Platform administrators manage staff scope and accounts, but cannot create platform admins in client code.
        (
          !isOwner(adminId) &&
          isPlatformAdmin() &&
          request.resource.data.role == resource.data.role &&
          (!('isPlatformAdmin' in request.resource.data) || request.resource.data.isPlatformAdmin == resource.data.isPlatformAdmin) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'designation', 'department', 'authorizedYears', 'authorizedClasses', 'isActive', 'accountStatus', 'deactivatedAt', 'deactivatedByUid', 'reactivatedAt', 'reactivatedByUid', 'updatedAt', 'researchSpecialization', 'customSpecialization', 'researchInterests', 'approvalStatus', 'approvedAt', 'approvedBy', 'approvedByUid']) &&
          validResearchSpecialization(request.resource.data)
        ) ||
        // Staff may update profile metadata only. Cannot escalate role, platform privileges, or change department/scope.
        (
          isOwner(adminId) && isStaff() &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.department == resource.data.department &&
          (!('isPlatformAdmin' in request.resource.data) || request.resource.data.isPlatformAdmin == resource.data.isPlatformAdmin) &&
          (!('isDepartmentApprover' in request.resource.data) || request.resource.data.isDepartmentApprover == resource.data.isDepartmentApprover) &&
          (!('authorizedYears' in request.resource.data) || request.resource.data.authorizedYears == resource.data.authorizedYears) &&
          (!('authorizedClasses' in request.resource.data) || request.resource.data.authorizedClasses == resource.data.authorizedClasses) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'designation', 'updatedAt', 'researchSpecialization', 'customSpecialization', 'researchInterests']) &&
          validResearchSpecialization(request.resource.data)
        )
      );
      allow delete: if isPlatformAdmin() && !isOwner(adminId);
    }

    // Registration Lookups: Single document lookup by normalized registration number
    // Public directory enumeration is forbidden (list: false).
    // Direct client access is restricted so unauthenticated users cannot harvest student emails.
    // Sensitive lookup resolution is handled by trusted backend (/api/student-auth).
    match /reg_lookups/{regNo} {
      allow get, list, write: if false;
    }

    // Email Lookups: Map normalized emails to UIDs for student uniqueness
    // Direct client access is forbidden; managed exclusively by trusted server SDK
    match /student_email_lookups/{emailDoc} {
      allow get, list, write: if false;
    }

    // Audit logs are immutable; staff audit log creation requires staff session.
    match /audit_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if isStaff() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email;
      allow update, delete: if false;
    }

    // Hackathons Collection: Public discovery for collegiate challenges; drafts are protected for admin view only
    match /hackathons/{hackathonId} {
      allow get: if (resource.data.status != 'DRAFT' && resource.data.status != 'draft') ||
        (
          isStaff() && (
            isPlatformAdmin() ||
            resource.data.department == getAdminDept() ||
            resource.data.publishedBy == request.auth.uid ||
            !('department' in resource.data)
          )
        );
      allow list: if resource.data.status in [
        'PUBLISHED', 'REGISTRATION_OPEN', 'REGISTRATION_CLOSED', 'UPCOMING', 'ONGOING', 'COMPLETED', 'CANCELLED', 'SUBMISSION_CLOSED',
        'published', 'registration_open', 'registration_closed', 'upcoming', 'ongoing', 'completed', 'cancelled', 'submission_closed'
      ] || (isStaff() && (isPlatformAdmin() || resource.data.department == getAdminDept() || resource.data.publishedBy == request.auth.uid));
      allow create: if isStaff() &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.organizer is string && request.resource.data.organizer.size() > 0 &&
        request.resource.data.shortDescription is string && request.resource.data.shortDescription.size() > 0 &&
        !('attendanceCode' in request.resource.data) && !('attendanceOpen' in request.resource.data) &&
        (isPlatformAdmin() ? isValidDepartment(request.resource.data.department) : request.resource.data.department == getAdminDept());
      allow update: if isStaff() && (isPlatformAdmin() || resource.data.department == getAdminDept() || resource.data.publishedBy == request.auth.uid) &&
        !('attendanceCode' in request.resource.data) && !('attendanceOpen' in request.resource.data) &&
        (!('department' in request.resource.data) || request.resource.data.department == resource.data.department);
      allow delete: if isStaff() && (isPlatformAdmin() || resource.data.department == getAdminDept() || resource.data.publishedBy == request.auth.uid);
    }

    // Registrations Collection: Students manage own registrations; faculty access scoped to department
    match /registrations/{registrationId} {
      allow read: if (isAuthenticated() && resource.data.studentId == request.auth.uid) ||
        canAccessScopedDepartment(resource.data.department, resource.data.academicYear);
      allow create: if isAuthenticated() &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.status == 'CONFIRMED' &&
        request.resource.data.submissionStatus == 'NOT_SUBMITTED' &&
        (!('attendedAt' in request.resource.data)) &&
        ((request.resource.data.isExternal == true && request.resource.data.externalTrackingOnly == true &&
          request.resource.data.attendanceStatus == 'ATTENDED' && request.resource.data.externalStatus == 'APPLIED_EXTERNALLY') ||
          (request.resource.data.isExternal != true && request.resource.data.attendanceStatus == 'PENDING')) &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        request.resource.data.department == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.department &&
        request.resource.data.academicYear == get(/databases/$(database)/documents/students/$(request.auth.uid)).data.year &&
        exists(/databases/$(database)/documents/hackathons/$(request.resource.data.hackathonId)) &&
        get(/databases/$(database)/documents/hackathons/$(request.resource.data.hackathonId)).data.status in ['PUBLISHED', 'REGISTRATION_OPEN', 'UPCOMING', 'published', 'registration_open', 'upcoming'];
      allow update: if (
        canAccessScopedDepartment(resource.data.department, resource.data.academicYear) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.hackathonId == resource.data.hackathonId &&
        request.resource.data.registrationNumber == resource.data.registrationNumber &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.academicYear == resource.data.academicYear &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status in ['CONFIRMED', 'CANCELLED']
      ) || (
        isAuthenticated() &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.hackathonId == resource.data.hackathonId &&
        request.resource.data.registrationNumber == resource.data.registrationNumber &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.academicYear == resource.data.academicYear &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedRules', 'updatedAt']) ||
          (
            resource.data.isExternal == true && resource.data.externalTrackingOnly == true &&
            request.resource.data.isExternal == true && request.resource.data.externalTrackingOnly == true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['externalStatus', 'externalNotes', 'updatedAt']) &&
            request.resource.data.externalStatus in ['PLANNING', 'APPLIED_EXTERNALLY', 'PARTICIPATING', 'COMPLETED', 'RESULT_RECORDED', 'WON', 'WITHDRAWN'] &&
            (!('externalNotes' in request.resource.data) || (request.resource.data.externalNotes is string && request.resource.data.externalNotes.size() <= 2000))
          )
        )
      );
      allow delete: if (
        canAccessScopedDepartment(resource.data.department, resource.data.academicYear)
      ) || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    // Team identifiers and membership are visible only to the team, its department staff, or platform admin.
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid ||
        (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds) ||
        canAccessScopedDepartment(resource.data.department, resource.data.academicYear)
      );
      // Creation and membership changes use trusted transactional server operations.
      allow create: if false;
      allow update: if isStaff() && canAccessScopedDepartment(resource.data.department, resource.data.academicYear);
      allow delete: if isStaff() && canAccessScopedDepartment(resource.data.department, resource.data.academicYear);
    }

    // Submissions Collection: Submitting student, teammate, or department admin can read/update; evaluation fields protected
    match /submissions/{submissionId} {
      allow read: if (
        isAuthenticated() && (
          resource.data.submittedBy == request.auth.uid ||
          resource.data.leaderId == request.auth.uid ||
          (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
        )
      ) || (
        canAccessScopedDepartment(resource.data.department, resource.data.academicYear)
      );
      allow create: if isAuthenticated() &&
      (request.resource.data.submittedBy == request.auth.uid || request.resource.data.leaderId == request.auth.uid) &&
      exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId)) &&
      get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.hackathonId == request.resource.data.hackathonId &&
      (get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.leaderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.memberIds) &&
      request.resource.data.leaderId == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.leaderId &&
      request.resource.data.memberIds == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.memberIds &&
      request.resource.data.department == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.department &&
      request.resource.data.academicYear == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.academicYear &&
      request.resource.data.hackathonId is string &&
      request.resource.data.projectTitle is string &&
      request.resource.data.isDraft is bool &&
      request.resource.data.status == (request.resource.data.isDraft ? 'DRAFT' : 'SUBMITTED') &&
      !('evaluationScore' in request.resource.data) && !('evaluationFeedback' in request.resource.data) && !('rank' in request.resource.data);
      allow update: if (
        canAccessScopedDepartment(resource.data.department, resource.data.academicYear) &&
        resource.data.isDraft == false &&
        resource.data.status in ['SUBMITTED', 'UNDER_REVIEW', 'SHORTLISTED', 'EVALUATED', 'WINNER'] &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.hackathonId == resource.data.hackathonId &&
        request.resource.data.submittedBy == resource.data.submittedBy &&
        request.resource.data.leaderId == resource.data.leaderId &&
        request.resource.data.memberIds == resource.data.memberIds &&
        request.resource.data.department == resource.data.department &&
        request.resource.data.academicYear == resource.data.academicYear &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evaluationScore', 'evaluationFeedback', 'rank', 'status', 'updatedAt']) &&
        request.resource.data.evaluationScore is number &&
        request.resource.data.evaluationScore >= 0 && request.resource.data.evaluationScore <= 100 &&
        request.resource.data.evaluationFeedback is string &&
        request.resource.data.evaluationFeedback.size() <= 5000 &&
        request.resource.data.status in ['UNDER_REVIEW', 'SHORTLISTED', 'EVALUATED', 'WINNER']
      ) || (
        isAuthenticated() &&
        (
          resource.data.submittedBy == request.auth.uid ||
          resource.data.leaderId == request.auth.uid ||
          (resource.data.memberIds != null && request.auth.uid in resource.data.memberIds)
        ) &&
        resource.data.isDraft == true &&
        request.resource.data.isDraft is bool &&
        request.resource.data.status in ['DRAFT', 'SUBMITTED'] &&
        request.resource.data.status == (request.resource.data.isDraft ? 'DRAFT' : 'SUBMITTED') &&
        request.resource.data.hackathonId == resource.data.hackathonId &&
        request.resource.data.teamId == resource.data.teamId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectTitle', 'projectName', 'title', 'tagline', 'description', 'solution',
          'technologies', 'techStack', 'githubUrl', 'demoUrl', 'liveDemoUrl',
          'presentationUrl', 'reportUrl', 'demoVideoUrl', 'videoDemoUrl',
          'problemStatementId', 'problemStatementTitle',
          'files', 'fileName', 'fileUrl', 'cloudinaryPublicId', 'fileSize', 'resourceType',
          'additionalNotes', 'isDraft', 'status', 'submittedAt', 'updatedAt', 'createdAt'
        ]) &&
        (!('evaluationScore' in request.resource.data) || request.resource.data.evaluationScore == resource.data.evaluationScore) &&
        (!('evaluationFeedback' in request.resource.data) || request.resource.data.evaluationFeedback == resource.data.evaluationFeedback) &&
        (!('rank' in request.resource.data) || request.resource.data.rank == resource.data.rank)
      );
      allow delete: if isStaff() && canAccessScopedDepartment(resource.data.department, resource.data.academicYear);
    }

    // Attendance Collection: Students can check in with check-in passcode; faculty managed by department
    match /attendance/{attendanceId} {
      allow read: if (isAuthenticated() && resource.data.studentId == request.auth.uid) || canAccessScopedDepartment(resource.data.department, resource.data.academicYear);
      // Check-in records and registration attendance updates are written transactionally by the server.
      allow create: if false;
      allow update, delete: if false;
    }

    // Attendance gate secrets are available only to the trusted API using Firebase Admin SDK.
    match /attendance_gates/{hackathonId} {
      allow read, write: if false;
    }

    // Campus bulletins are public; department bulletins are limited to that department's staff and students.
    match /announcements/{announcementId} {
      allow read: if isPlatformAdmin() || resource.data.target == 'ALL' || canAccessDepartment(resource.data.department) || (
        isAuthenticated() && resource.data.target == 'DEPT' &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.department == resource.data.department
      );
      allow create: if isStaff() && (
        (isPlatformAdmin() && request.resource.data.target == 'ALL') ||
        (request.resource.data.target == 'DEPT' && request.resource.data.department == getAdminDept())
      );
      allow update: if isStaff() && (
        (isPlatformAdmin() && request.resource.data.target == 'ALL') ||
        (resource.data.target == 'DEPT' && resource.data.department == getAdminDept() &&
          request.resource.data.target == 'DEPT' && request.resource.data.department == resource.data.department)
      );
      allow delete: if isStaff() && (isPlatformAdmin() || (resource.data.target == 'DEPT' && resource.data.department == getAdminDept()));
    }

    // Notifications Collection: Scoped to user or broadcast 'ALL'; forged creation prevented
    match /notifications/{notificationId} {
      allow read: if isPlatformAdmin() || (isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ALL' ||
        canAccessDepartment(resource.data.department)
      ));
      allow update, delete: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && request.resource.data.userId == 'ALL';
    }

    // Per-user notification read markers avoid changing a broadcast for every recipient.
    match /notification_reads/{readId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.notificationId is string &&
        readId == request.auth.uid + '_' + request.resource.data.notificationId &&
        request.resource.data.readAt == request.time;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.notificationId == resource.data.notificationId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) &&
        request.resource.data.readAt == request.time;
      allow delete: if false;
    }

    // Student certificates are private to the student and authorized staff in their department.
    match /certificates/{certificateId} {
      allow read: if (isAuthenticated() && resource.data.studentId == request.auth.uid) || canAccessScopedDepartment(resource.data.department, resource.data.academicYear);
      allow create: if isStaff() && (isPlatformAdmin() || canAccessScopedDepartment(request.resource.data.department, request.resource.data.academicYear));
      allow update, delete: if isStaff() && (isPlatformAdmin() || canAccessScopedDepartment(resource.data.department, resource.data.academicYear));
    }

    // Default catch-all denies unexpected paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
