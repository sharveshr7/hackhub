rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Students Collection: Users can manage their own profile; cannot elevate role to admin; admins can supervise
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(studentId) && (!('role' in request.resource.data) || request.resource.data.role == 'STUDENT' || request.resource.data.role == 'student');
      allow update: if (isOwner(studentId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || request.resource.data.role == 'STUDENT' || request.resource.data.role == 'student')) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection: Read allowed if authenticated
    // Create allowed for verified admins, OR new authenticated user initializing their own profile (not existing student)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isOwner(adminId) &&
        request.resource.data.uid == request.auth.uid &&
        request.auth.token.email != null &&
        request.resource.data.email == request.auth.token.email &&
        !exists(/databases/$(database)/documents/students/$(request.auth.uid))
      );
      allow update, delete: if isAdmin();
    }

    // Hackathons Collection: Public discovery for collegiate challenges; only admins can create/edit/delete
    match /hackathons/{hackathonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations Collection: Students manage own registrations; admins have supervision access
    match /registrations/{registrationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
    }

    // Teams Collection: Created by student leader; updated by members; deleted by leader or admin
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.leaderId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.leaderId == request.auth.uid);
    }

    // Submissions Collection: Only the submitting student or admin can create/update
    match /submissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.submittedBy == request.auth.uid ||
        request.resource.data.leaderId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.submittedBy == request.auth.uid ||
        resource.data.leaderId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Attendance Collection: Students can check in with gate code; cannot modify arbitrarily afterwards
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Announcements Collection: Public read notice board; only admins can publish/remove
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications Collection: Scoped to user or broadcast 'ALL'
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'ALL' ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }

    // Certificates Collection: Public read for diploma verification; only admins can issue
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default catch-all denies unexpected paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
